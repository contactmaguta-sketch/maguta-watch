<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Maguta Watch AI</title>
  <style>
    :root{--bg:#f5efe4;--ink:#1c1a17;--gold:#9b742d;--soft:#fffaf0;--line:#d8c8aa;--green:#1f7a4d;--red:#9b2c2c}*{box-sizing:border-box}body{margin:0;font-family:Georgia,'Times New Roman',serif;background:var(--bg);color:var(--ink)}.wrap{max-width:980px;margin:auto;padding:26px}.top{display:flex;justify-content:space-between;align-items:center;gap:18px}.brand{font-size:34px;letter-spacing:.22em;color:var(--gold);line-height:1.1}.brand span{display:block;color:#16130f}.pill{border:1px solid var(--line);border-radius:999px;padding:6px;background:#fff4d9;display:flex;gap:4px}.pill button{border:0;border-radius:999px;padding:10px 14px;background:transparent;cursor:pointer;font-weight:700}.pill button.active{background:var(--gold);color:white}.hero{padding:55px 0 35px;text-align:center}.eyebrow{color:var(--gold);letter-spacing:.25em;font-size:12px;text-transform:uppercase;font-weight:bold}.hero h1{font-size:clamp(38px,7vw,74px);line-height:.98;margin:18px 0;letter-spacing:.02em}.hero p{max-width:720px;margin:0 auto;color:#5d5347;font-size:19px;line-height:1.6}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:30px 0}.card{background:var(--soft);border:1px solid var(--line);border-radius:24px;padding:24px;box-shadow:0 18px 45px rgba(77,55,19,.1)}.card h3{font-size:24px;margin:0 0 10px}.price{font-size:42px;color:var(--gold);font-weight:bold;margin:15px 0}.small{color:#6d6256;font-size:14px;line-height:1.5}.billing{text-align:center;margin:12px 0 20px}.billing button{padding:12px 18px;border:1px solid var(--line);background:#fff8e9;cursor:pointer;font-weight:bold}.billing button.active{background:var(--gold);color:white}.btn{width:100%;border:0;border-radius:14px;padding:15px 16px;font-size:15px;font-weight:bold;cursor:pointer;background:var(--ink);color:white;margin-top:12px}.btn.gold{background:var(--gold)}.formbox{background:var(--soft);border:1px solid var(--line);border-radius:28px;padding:24px;margin:35px 0}label{font-weight:bold;display:block;margin:14px 0 7px;letter-spacing:.08em;text-transform:uppercase;color:var(--gold);font-size:12px}input,select,textarea{width:100%;padding:14px;border:1px solid var(--line);border-radius:12px;background:#fffdfa;font:inherit}textarea{min-height:110px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.status{display:none;margin-top:18px;padding:14px;border-radius:12px;background:#fff3cd;color:#5a4700}.status.ok{background:#ddf7e8;color:#0f5132}.status.err{background:#f8d7da;color:#842029}.foot{text-align:center;color:#6d6256;padding:35px 0}@media(max-width:820px){.cards,.grid{grid-template-columns:1fr}.top{align-items:flex-start}.brand{font-size:28px}.wrap{padding:18px}}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="top">
      <div class="brand">MAGUTA <span>WATCH</span></div>
      <div class="pill"><button class="active" data-lang="fr">FR</button><button data-lang="en">EN</button></div>
    </div>

    <section class="hero">
      <div class="eyebrow" data-i18n="eyebrow">Veille concurrentielle automatisée</div>
      <h1 data-i18n="title">Surveillez vos concurrents automatiquement</h1>
      <p data-i18n="subtitle">Sélectionnez une offre, configurez votre entreprise, puis recevez une confirmation immédiate et un premier rapport généré automatiquement.</p>
    </section>

    <div class="billing">
      <button class="active" data-billing="monthly" data-i18n="monthly">Mensuel</button><button data-billing="yearly" data-i18n="yearly">Annuel - économisez 2 mois</button>
    </div>

    <section class="cards">
      <div class="card"><h3>Starter</h3><p class="small" data-i18n="starterText">Pour une première veille locale.</p><div class="price" data-price="starter">€9</div><p class="small" data-period="starter">/mois</p><button class="btn" data-plan="starter">Choisir Starter</button></div>
      <div class="card"><h3>Pro</h3><p class="small" data-i18n="proText">Pour suivre plus de concurrents et recevoir une analyse plus avancée.</p><div class="price" data-price="pro">€19</div><p class="small" data-period="pro">/mois</p><button class="btn gold" data-plan="pro">Choisir Pro</button></div>
      <div class="card"><h3>Enterprise</h3><p class="small" data-i18n="enterpriseText">Pour les zones plus larges et les recommandations stratégiques.</p><div class="price" data-price="enterprise">€29</div><p class="small" data-period="enterprise">/mois</p><button class="btn" data-plan="enterprise">Choisir Enterprise</button></div>
    </section>

    <section class="formbox" id="onboarding">
      <h2 data-i18n="formTitle">Configurer votre rapport</h2>
      <p class="small" data-i18n="formHelp">Remplissez ce formulaire puis vous serez redirigé vers le paiement. Vos emails arriveront automatiquement après confirmation.</p>
      <form id="magutaForm">
        <input type="hidden" name="plan" id="plan" value="starter" />
        <input type="hidden" name="billing" id="billing" value="monthly" />
        <input type="hidden" name="language" id="language" value="fr" />
        <div class="grid">
          <div><label>Entreprise</label><input name="company" required placeholder="MAGENTA Home Design - Veneta Cucine" /></div>
          <div><label>Email client</label><input name="email" type="email" required placeholder="client@email.com" /></div>
          <div><label>Secteur</label><input name="industry" required placeholder="Cuisiniste / showroom cuisine" /></div>
          <div><label>Zone</label><input name="zone" required placeholder="Crissier, Suisse" /></div>
          <div><label>Adresse</label><input name="address" placeholder="Chem. de Mongevon 2, 1023 Crissier" /></div>
          <div><label>Site internet</label><input name="website" placeholder="https://..." /></div>
        </div>
        <label>Concurrents connus</label><textarea name="competitors" placeholder="Côté Cuisines Sàrl — Prilly&#10;TEK Cuisines SA — Crissier&#10;APF Etoy — Etoy"></textarea>
        <label>Notes internes</label><textarea name="notes" placeholder="Objectif, cible, éléments à surveiller..."></textarea>
        <button class="btn gold" type="submit" data-i18n="submit">Continuer vers le paiement →</button>
      </form>
      <div id="status" class="status"></div>
    </section>

    <div class="foot">Maguta Watch AI · Intelligence · Market · Precision<br/>contactmaguta@gmail.com</div>
  </div>

<script>
const STRIPE = {
 monthly: {
  starter:'https://buy.stripe.com/aFadR12RlcbRgwx7AS0Fi00',
  pro:'https://buy.stripe.com/bJe8wH63xgs73JL6wO0Fi02',
  enterprise:'https://buy.stripe.com/8x29ALbnR3Fla899J00Fi01'
 },
 yearly: {
  starter:'https://buy.stripe.com/9B6dR1dvZ7VB2FH9J00Fi05',
  pro:'https://buy.stripe.com/3cI28j9fJ5Nt6VXaN40Fi03',
  enterprise:'https://buy.stripe.com/3cIeV577B2Bha891cu0Fi04'
 }
};
const PRICES={monthly:{starter:['€9','/mois'],pro:['€19','/mois'],enterprise:['€29','/mois']},yearly:{starter:['€90','/an'],pro:['€190','/an'],enterprise:['€290','/an']}};
let lang='fr', billing='monthly';
const t={fr:{eyebrow:'Veille concurrentielle automatisée',title:'Surveillez vos concurrents automatiquement',subtitle:'Sélectionnez une offre, configurez votre entreprise, puis recevez une confirmation immédiate et un premier rapport généré automatiquement.',monthly:'Mensuel',yearly:'Annuel - économisez 2 mois',starterText:'Pour une première veille locale.',proText:'Pour suivre plus de concurrents et recevoir une analyse plus avancée.',enterpriseText:'Pour les zones plus larges et les recommandations stratégiques.',formTitle:'Configurer votre rapport',formHelp:'Remplissez ce formulaire puis vous serez redirigé vers le paiement. Vos emails arriveront automatiquement après confirmation.',submit:'Continuer vers le paiement →'},en:{eyebrow:'Automated competitor intelligence',title:'Automatically monitor your competitors',subtitle:'Choose a plan, configure your business, then receive an immediate confirmation and a first automated report.',monthly:'Monthly',yearly:'Yearly - save 2 months',starterText:'For a first local intelligence report.',proText:'For tracking more competitors with deeper analysis.',enterpriseText:'For wider areas and strategic recommendations.',formTitle:'Configure your report',formHelp:'Fill in this form and you will be redirected to payment. Your emails will arrive automatically after confirmation.',submit:'Continue to payment →'}};
function setLang(l){lang=l;document.getElementById('language').value=l;document.querySelectorAll('[data-i18n]').forEach(e=>e.textContent=t[l][e.dataset.i18n]);document.querySelectorAll('[data-lang]').forEach(b=>b.classList.toggle('active',b.dataset.lang===l));}
function setBilling(b){billing=b;document.getElementById('billing').value=b;document.querySelectorAll('[data-billing]').forEach(x=>x.classList.toggle('active',x.dataset.billing===b));['starter','pro','enterprise'].forEach(p=>{document.querySelector(`[data-price="${p}"]`).textContent=PRICES[b][p][0];document.querySelector(`[data-period="${p}"]`).textContent=PRICES[b][p][1];});}
document.querySelectorAll('[data-lang]').forEach(b=>b.onclick=()=>setLang(b.dataset.lang));
document.querySelectorAll('[data-billing]').forEach(b=>b.onclick=()=>setBilling(b.dataset.billing));
document.querySelectorAll('[data-plan]').forEach(b=>b.onclick=()=>{document.getElementById('plan').value=b.dataset.plan;document.getElementById('onboarding').scrollIntoView({behavior:'smooth'});});
const params=new URLSearchParams(location.search); if(params.get('plan')) document.getElementById('plan').value=params.get('plan'); if(params.get('period')){setBilling(params.get('period'));}
const status=document.getElementById('status');
function show(msg,type=''){status.style.display='block';status.className='status '+type;status.textContent=msg;}

const API='https://3cbc0227-1e60-4dd6-ae20-b4b51648850c-00-3n2ph23sgpp77.riker.replit.dev';
document.getElementById('magutaForm').addEventListener('submit',async(e)=>{
 e.preventDefault();show(lang==='fr'?'Redirection vers le paiement...':'Redirecting to payment...');
 const data=Object.fromEntries(new FormData(e.target).entries());
 try{
  const r=await fetch(API+'/api/presave',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
  const j=await r.json().catch(()=>({}));
  if(!r.ok)throw new Error(j.error||'Erreur inconnue');
  if(j.url){window.location.href=j.url;}
  else{show(lang==='fr'?'Lien introuvable.':'Link not found.','err');}
 }catch(err){show((lang==='fr'?'Erreur: ':'Error: ')+err.message,'err');}
});
</script>
</body>
</html>
